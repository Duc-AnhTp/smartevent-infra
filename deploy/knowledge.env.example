# Copy values into your deployment environment; never commit real credentials.
KNOWLEDGE_BOOTSTRAP_PASSWORD=
KNOWLEDGE_READER_PASSWORD=
KNOWLEDGE_INGESTER_PASSWORD=
# At least 32 random characters, server-side only.
KNOWLEDGE_SERVICE_TOKEN=
KNOWLEDGE_MODEL_DIR=
KNOWLEDGE_CATALOG_SHA256=
KNOWLEDGE_RELEASE_SHA256=
EMBEDDING_PROFILE_SHA256=
RETRIEVAL_MODE=bm25
# fail_closed returns 503; bm25 explicitly allows degraded lexical serving.
DENSE_FAILURE_POLICY=fail_closed
RETRIEVAL_EVALUATION_SHA256=
# Optional: POLICY_BACKEND=http only after reviewed AI RAG gates pass.
